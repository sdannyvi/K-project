# Copy to .env and fill in. Used by llm_client (chat + RAG embeddings).

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Required for RAG: embedding deployment on the SAME endpoint as above.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Optional alias if you prefer this name instead:
# OPENAI_EMBEDDING_DEPLOYMENT=
